# URL base da API Django REST Framework.
# Em desenvolvimento local, ajuste a porta para a do seu backend.
VITE_API_BASE_URL=http://localhost:8000/api

# true  -> usa o backend simulado em memória (dados fictícios, sem HTTP).
# false -> usa a API real configurada em VITE_API_BASE_URL.
#
# O modo de demonstração é sempre indicado visualmente na interface e
# nunca se mistura com dados reais.
VITE_DEMO_MODE=true
